generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FRESHER
  SENIOR
  ADMIN
}

enum TipCategory {
  SCHOLARSHIP
  FACULTY
  PLACEMENT
  CLUB
  DEPARTMENT_NORM
  ACADEMIC
  OTHER
}

enum TipStatus {
  PENDING
  VERIFIED
  DISPUTED
  NEEDS_CONTEXT
  ARCHIVED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceQuality {
  HEARD_FROM_PEER
  DIRECT_EXPERIENCE
  REPEATED_PATTERN
  DOCUMENTED
}

enum VerificationType {
  VERIFY
  DISPUTE
  NEEDS_CONTEXT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  tips     Tip[]
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users   User[]
  tips    Tip[]

  @@unique([collegeId, code])
}

model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   UserRole
  emailVerified          Boolean  @default(true)
  emailVerificationToken String?
  semester               Int?
  graduationYear         Int?
  isFirstGen             Boolean  @default(false)
  credibilityScore       Int      @default(50)
  collegeId              String?
  branchId               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  college       College?          @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  authoredTips  Tip[]             @relation("TipAuthor")
  verifications TipVerification[]
  chatSessions  ChatSession[]
  chatMessages  ChatMessage[]
}

model Tip {
  id               String          @id @default(cuid())
  title            String
  body             String
  summary          String?
  actionSteps      String[]
  audience         String?
  category         TipCategory     @default(OTHER)
  urgency          Urgency         @default(MEDIUM)
  status           TipStatus       @default(PENDING)
  evidenceQuality  EvidenceQuality @default(DIRECT_EXPERIENCE)
  sourceConfidence Int             @default(60)
  deadline         DateTime?
  signalRank       Int             @default(0)
  embedding        Unsupported("vector(1536)")?
  authorId         String
  collegeId        String
  branchId         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  author        User              @relation("TipAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  college       College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  verifications TipVerification[]
  nudges        Nudge[]

  @@index([collegeId, branchId])
  @@index([status, urgency])
  @@index([deadline])
}

model TipVerification {
  id        String           @id @default(cuid())
  tipId     String
  userId    String
  type      VerificationType
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tip  Tip  @relation(fields: [tipId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tipId, userId])
}

model Nudge {
  id        String   @id @default(cuid())
  userId    String?
  tipId     String
  title     String
  message   String
  dueAt     DateTime
  readAt    DateTime?
  createdAt DateTime @default(now())

  tip Tip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  role      ChatRole
  content   String
  sources   String[]
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}
